import json
import logging
import sys

import pytest

from {{ package_name }}.main import JsonFormatter, greet, main


def test_greet() -> None:
    assert greet("  Ada ") == "Hello, Ada!"


def test_greet_rejects_blank_names() -> None:
    with pytest.raises(ValueError):
        greet("   ")


def test_main_logs_json(capsys: pytest.CaptureFixture[str]) -> None:
    assert main(["Ada"]) == 0
    line = json.loads(capsys.readouterr().out.strip().splitlines()[-1])
    assert line["message"] == "Hello, Ada!"
    assert line["level"] == "INFO"


def test_formatter_includes_exceptions() -> None:
    try:
        raise RuntimeError("boom")
    except RuntimeError:
        record = logging.LogRecord("x", logging.ERROR, __file__, 1, "failed", None, exc_info=sys.exc_info())
    assert "RuntimeError: boom" in json.loads(JsonFormatter().format(record))["exception"]
