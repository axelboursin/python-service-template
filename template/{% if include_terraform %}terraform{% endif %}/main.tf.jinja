# Infrastructure for {{ project_name }}.
terraform {
  required_version = ">= 1.10"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # Partial config: pass bucket/key/region with -backend-config.
  backend "s3" {
    use_lockfile = true
    encrypt      = true
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project   = "{{ project_slug }}"
      ManagedBy = "terraform"
    }
  }
}

variable "aws_region" {
  type    = string
  default = "eu-west-3"
}
